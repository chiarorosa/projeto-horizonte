ai/models/
ai/data/raw/
ai/data/processed/
ai/vectorstore/
*.ckpt
*.safetensors
*.onnx
*.gguf
*.pt
*.pth
*.h5
mlruns/
wandb/

# ---------- Banco de dados local ----------
*.sqlite
*.sqlite3
*.db

