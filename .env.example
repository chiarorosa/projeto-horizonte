# =========================================================
# Projeto Horizonte — exemplo de variáveis de ambiente
# =========================================================
# Copie para .env e preencha localmente:  cp .env.example .env
# NUNCA versione o arquivo .env nem coloque valores reais aqui.
# Ao adicionar uma variável nova, inclua-a também na tabela do README.md.

# ---------- Geral ----------
APP_ENV=development

# ---------- Banco de dados (PostgreSQL no Neon, com pgvector) ----------
# Banco compartilhado: Neon → Connect, branch "dev-banco" (desenvolvimento), com
# "Connection pooling" DESLIGADO (conexão direta, sem -pooler no host). A branch
# "production" é só para o que já foi integrado. Passo a passo: README.md §4.
DATABASE_URL=

# ---------- Backend ----------
BACKEND_PORT=8000
JWT_SECRET=

# ---------- Frontend ----------
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# ---------- IA ----------
AI_PORT=8001
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo do OpenRouter. Gratuitos (sufixo :free): https://openrouter.ai/models?q=free
# O teste de integração usou openrouter/free, um roteador que troca de modelo a
# cada chamada; para comparar resultados, prefira um id fixo terminado em :free.
# Privacy do OpenRouter: deixe DESLIGADA "Allow free endpoints that train on request
# data" (testado: openrouter/free funciona assim). Detalhes: README.md §4.
OPENROUTER_MODEL=
# local (Sentence Transformers) ou openrouter
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
