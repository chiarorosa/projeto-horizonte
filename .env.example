# =========================================================
# Projeto Horizonte — exemplo de variáveis de ambiente
# =========================================================
# Copie para .env e preencha localmente:  cp .env.example .env
# NUNCA versione o arquivo .env nem coloque valores reais aqui.
# Ao adicionar uma variável nova, documente-a em docs/DEVELOPMENT.md.

# ---------- Geral ----------
APP_ENV=development

# ---------- Backend ----------
BACKEND_PORT=8000
DATABASE_URL=
JWT_SECRET=

# ---------- Frontend ----------
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# ---------- IA ----------
AI_PORT=8001
LLM_PROVIDER=
LLM_API_KEY=
